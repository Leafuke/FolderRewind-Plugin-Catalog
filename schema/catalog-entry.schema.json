{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://leafuke.github.io/FolderRewind-Plugin-Catalog/schema/catalog-entry.v1.json",
  "title": "FolderRewind Official Catalog Entry v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "pluginId", "version", "channel", "pluginApi", "architectures", "artifact", "provenance", "trustClassification", "requestedHostServices", "artifactFormats", "artifactTransformers", "restoreStrategies"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "pluginId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*(\\.[a-z0-9][a-z0-9-]*)+$" },
    "version": { "type": "string" },
    "channel": { "enum": ["stable", "prerelease", "candidate"] },
    "pluginApi": { "type": "object", "additionalProperties": false, "required": ["major", "minor"], "properties": { "major": { "type": "integer", "minimum": 0 }, "minor": { "type": "integer", "minimum": 0 } } },
    "architectures": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["any", "x86", "x64", "arm64"] } },
    "artifact": { "type": "object", "additionalProperties": false, "required": ["url", "sha256"], "properties": { "url": { "type": "string", "pattern": "^https://" }, "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" } } },
    "provenance": { "const": "officialCatalog" },
    "trustClassification": { "enum": ["official", "officialCurated"] },
    "requestedHostServices": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
    "artifactFormats": { "type": "array", "items": { "type": "string" } },
    "artifactTransformers": { "type": "array", "items": { "type": "string" } },
    "restoreStrategies": { "type": "array", "items": { "type": "string" } },
    "futureSignature": { "type": ["object", "null"] }
  }
}
